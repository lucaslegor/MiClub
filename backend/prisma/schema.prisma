// Schema base de Prisma para MiClub SaaS.
// A propósito, SIN modelos todavía: el modelo de datos se define más adelante
// (ver docs/02-glosario-y-dominio.md). Solo dejamos configurados el generator
// y el datasource sobre PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
